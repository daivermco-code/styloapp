# Copia este archivo como .env.local y pon los valores de tu Supabase.
# Con el Supabase local (`npm run db:start`), el CLI imprime la URL y las llaves al arrancar.

# URL de la API de Supabase (servidor). Local: http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321

# Llave pública (anon). Va al navegador; las políticas RLS protegen los datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-llave-anon

# Llave de servicio (secreta, solo servidor): se usa para reiniciar la demo y para las pruebas.
SUPABASE_SERVICE_ROLE_KEY=tu-llave-service-role

# Solo si la base no es la local: URL pública de Supabase para el navegador.
# NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Pruebas de base de datos (opcional). Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
